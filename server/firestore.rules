// Server-only Firestore access.
// The Node.js backend uses Firebase Admin SDK, so it bypasses these client rules.
// Deploy this after migrating the React client from direct Firestore access to /api/entries.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
