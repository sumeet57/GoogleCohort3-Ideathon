# Server
PORT=8080
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

# Firebase / Google Cloud
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Secret Manager
# Create this secret in Google Cloud Secret Manager and store your Vertex AI API key in it.
GEMINI_API_KEY_SECRET_ID=gemini-api-key
GEMINI_API_KEY_SECRET_VERSION=latest

# Gemini
# The UI calls this Gemini 3.6 Flash. The current production model is configurable here.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING_LEVEL=MEDIUM

# Safety / request limits
MAX_BODY_BYTES=256kb
MAX_HISTORY_MESSAGES=24
MAX_HISTORY_CHARS=30000
MAX_ENTRY_TEXT_CHARS=50000
MAX_PROMPT_CHARS=8000
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
